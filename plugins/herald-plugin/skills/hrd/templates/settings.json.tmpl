{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/herald/scripts/:*)",
      "Bash(git:*)",
      "Bash(gh:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/herald/scripts/guard.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/herald/scripts/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
