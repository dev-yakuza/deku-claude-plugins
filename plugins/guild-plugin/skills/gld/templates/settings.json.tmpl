{
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash({{TEST_BIN}}:*)",
      "Bash({{LINT_BIN}}:*)"
      {{ADDITIONAL_BIN_ENTRIES}}
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/guild/gates/scripts/gate_precommit.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/guild/gates/scripts/gate_precommit.py\" --guard-config",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
