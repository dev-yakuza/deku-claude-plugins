{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gld/template",
  "title": "Procedure template — .claude/guild/procedures/<type>.yaml and the plugin start procedure (design §2, §3.1, §9.1)",
  "description": "One template = one file holding every step (§2). JSON text (a YAML 1.2 subset). Paths may use the placeholder {issue} and, as a whole item, {path:test-code} / {path:safety-net} (stage 3, E4); the engine substitutes it when it copies start procedure + template into procedure.yaml (stage 1: copied as is, no adjustment — §9.2). A control file (§7.6): read only from the recorded base SHA blob. $defs are identical to procedure.schema.json (tests/test_contracts.py checks).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "template",
    "version",
    "steps"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "template": {
      "$ref": "#/$defs/name",
      "description": "Template name (feature, bug, …; the plugin start procedure is named start)."
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?!in:)(?!.*\\{path:)(?!.*(^|/)\\.\\.(/|$))[^\\s\\\\]+$",
      "description": "Worktree-relative path or glob. No leading /, no .. segment, no whitespace (a command string cannot be one)."
    },
    "path_token": {
      "enum": [
        "{path:test-code}",
        "{path:safety-net}"
      ],
      "description": "Stage 3 (E4), templates only: a whole item the engine replaces by the globs of the repository's path rules of that kind. procedure.py refuses it in a procedure and before stage 3."
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/relpath"
        },
        {
          "$ref": "#/$defs/path_token"
        },
        {
          "type": "string",
          "pattern": "^in:(issue\\.md|leader-decision\\.md|failure-summary\\.md|review\\.diff|leader-input\\.json|repro-evidence\\.md|blocking-discoveries\\.md|pr-review\\.md|git-history\\.md)$",
          "description": "An engine-made input in the attempt's in/ folder (§6.2, §7.12 S7)."
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/relpath"
          },
          {
            "$ref": "#/$defs/path_token"
          }
        ]
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "uniqueItems": true,
      "description": "Non-empty = a review step (§4): the review result schema is used."
    },
    "on_fail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "back_to",
        "max"
      ],
      "properties": {
        "back_to": {
          "$ref": "#/$defs/name"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "role_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "role": {
          "$ref": "#/$defs/name"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "outputs": {
          "$ref": "#/$defs/outputs"
        },
        "on_fail": {
          "$ref": "#/$defs/on_fail"
        },
        "checks": {
          "$ref": "#/$defs/checks"
        }
      }
    },
    "run_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "run"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "run": {
          "$ref": "#/$defs/name",
          "description": "A named command of the repository settings (§7.10) — never a command string."
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "on_fail": {
          "$ref": "#/$defs/on_fail"
        }
      }
    },
    "check_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "check"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "check": {
          "enum": [
            "plan-gate",
            "done-gate"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        }
      }
    },
    "op_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "op"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "op": {
          "enum": [
            "create-pr",
            "create-followups",
            "create-children",
            "run-children"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/role_step"
        },
        {
          "$ref": "#/$defs/run_step"
        },
        {
          "$ref": "#/$defs/check_step"
        },
        {
          "$ref": "#/$defs/op_step"
        }
      ]
    }
  }
}
