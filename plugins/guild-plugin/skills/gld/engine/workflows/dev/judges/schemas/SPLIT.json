{
 "type": "object",
 "required": [
  "decision",
  "slices",
  "reason",
  "security_concern"
 ],
 "properties": {
  "decision": {
   "type": "string",
   "enum": [
    "single",
    "split",
    "unsure"
   ]
  },
  "slices": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "key",
     "name",
     "scope",
     "ac_ids",
     "order"
    ],
    "properties": {
     "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
     },
     "name": {
      "type": "string"
     },
     "scope": {
      "type": "string"
     },
     "ac_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "order": {
      "type": "integer"
     }
    }
   }
  },
  "reason": {
   "type": "string"
  },
  "security_concern": {
   "type": "boolean"
  },
  "security_reason": {
   "type": "string"
  }
 }
}