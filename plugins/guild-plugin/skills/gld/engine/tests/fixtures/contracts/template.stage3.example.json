{
  "format": 1,
  "template": "bug",
  "version": "example-s3",
  "description": "EXAMPLE ONLY — the real feature template is U15's.",
  "steps": [
    {
      "id": "reproduce",
      "role": "developer",
      "inputs": [
        "docs/specs/{issue}/analysis.md",
        "in:failure-summary.md"
      ],
      "outputs": [
        "{path:test-code}"
      ],
      "on_fail": {
        "back_to": "reproduce",
        "max": 2
      }
    },
    {
      "id": "repro-red",
      "run": "repro-red",
      "on_fail": {
        "back_to": "reproduce",
        "max": 2
      }
    },
    {
      "id": "fix",
      "role": "developer",
      "inputs": [
        "in:repro-evidence.md",
        "in:blocking-discoveries.md",
        "{path:test-code}"
      ],
      "outputs": []
    },
    {
      "id": "done-gate",
      "check": "done-gate",
      "inputs": [
        "in:repro-evidence.md"
      ]
    },
    {
      "id": "pr",
      "op": "create-pr"
    },
    {
      "id": "followups",
      "op": "create-followups"
    }
  ]
}
