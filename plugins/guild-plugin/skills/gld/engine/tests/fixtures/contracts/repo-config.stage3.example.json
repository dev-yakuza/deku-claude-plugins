{
  "format": 1,
  "commands": {
    "setup": {
      "cmd": "pnpm install --frozen-lockfile"
    },
    "test": {
      "cmd": "pnpm test -- --ci",
      "timeout_min": 30
    },
    "e2e": {
      "cmd": "pnpm e2e --ci",
      "timeout_min": 45
    },
    "ac-format": {
      "plugin": "ac-format"
    },
    "ac-coverage": {
      "plugin": "ac-coverage"
    },
    "verify-gate": {
      "plugin": "verify-gate"
    },
    "repro-red": {
      "plugin": "repro-red"
    },
    "safety-net-proof": {
      "plugin": "safety-net-proof"
    },
    "verification-frozen": {
      "plugin": "verification-frozen"
    },
    "no-production-change": {
      "plugin": "no-production-change"
    }
  },
  "run_timeout_min": 30,
  "toolchain_prepare": [
    {
      "name": "flutter-sdk",
      "sync": {
        "from": [
          "{home}/fvm/versions/3.47.7",
          "/opt/flutter"
        ],
        "to": "flutter-sdk"
      }
    },
    {
      "name": "flutter-precache",
      "cmd": "flutter precache"
    }
  ],
  "path_rules": [
    {
      "kind": "verification",
      "globs": [
        "test/**",
        "**/*_test.dart",
        "package.json",
        ".github/workflows/**"
      ],
      "category": "test"
    },
    {
      "kind": "risk",
      "area": "auth",
      "gate": "security-review",
      "globs": [
        "src/auth/**"
      ]
    },
    {
      "kind": "irreversible",
      "category": "hard-to-revert",
      "globs": [
        "migrations/**"
      ]
    },
    {
      "kind": "verification",
      "category": "golden",
      "globs": [
        "test/goldens/**"
      ]
    },
    {
      "kind": "test-code",
      "globs": [
        "test/**/*_test.dart"
      ],
      "note": "test sources only"
    },
    {
      "kind": "safety-net",
      "globs": [
        "test/**/*_safety_net_test.dart"
      ]
    }
  ],
  "registry_hosts": [
    "registry.npmjs.org",
    "repo.yarnpkg.com"
  ],
  "cache_env": {
    "npm_config_cache": "{cache}/npm",
    "COREPACK_HOME": "{cache}/corepack"
  },
  "run_env": {
    "TURBO_TELEMETRY_DISABLED": "1"
  },
  "secret_paths": [
    ".env*",
    "*.pem",
    "*.p12"
  ],
  "worktree_prepare": [
    {
      "copy": "lib/generated/**",
      "note": "ignored codegen output"
    }
  ],
  "sandbox_exceptions": {
    "allow_local_binding": false
  },
  "quarantine": [
    {
      "test": "test/flaky_clock_test.dart",
      "note": "red on base since 2026-11-01"
    }
  ],
  "not_checked_locally": [
    {
      "name": "deploy-preview",
      "note": "needs secrets"
    }
  ],
  "source": {
    "converted_from": "0.98.7 config.json",
    "at": "2026-11-23T01:02:03Z"
  },
  "irreversible_levels": {
    "human-executed": "proceed"
  },
  "followups_dry_run": true,
  "allowed_models": [
    "opus",
    "sonnet",
    "haiku",
    "fable"
  ],
  "allowed_efforts": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ]
}
