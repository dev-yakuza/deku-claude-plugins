{
  "format": 1,
  "template": "feature",
  "version": "example-1",
  "description": "EXAMPLE ONLY — the real feature template is U15's.",
  "steps": [
    {
      "id": "design",
      "role": "tech-lead",
      "inputs": [
        "docs/specs/{issue}/analysis.md"
      ],
      "outputs": [
        "docs/specs/{issue}/design.md"
      ]
    },
    {
      "id": "setup",
      "run": "setup"
    },
    {
      "id": "developer",
      "role": "developer",
      "inputs": [
        "docs/specs/{issue}/design.md"
      ],
      "outputs": []
    },
    {
      "id": "test",
      "run": "test",
      "on_fail": {
        "back_to": "developer",
        "max": 3
      }
    },
    {
      "id": "review",
      "role": "auditor",
      "inputs": [
        "in:review.diff",
        "docs/specs/{issue}/design.md"
      ],
      "outputs": [
        "docs/specs/{issue}/review-auditor.md"
      ],
      "checks": [
        "diff-review"
      ],
      "on_fail": {
        "back_to": "developer",
        "max": 2
      }
    },
    {
      "id": "verify-gate",
      "run": "verify-gate",
      "on_fail": {
        "back_to": "developer",
        "max": 2
      }
    },
    {
      "id": "pr",
      "op": "create-pr"
    }
  ]
}
