{
  "format": 1,
  "version": "example-1",
  "entries": [
    {
      "id": "ux-design",
      "role": "designer",
      "class": "design-time",
      "inputs": [
        "docs/specs/{issue}/analysis.md",
        "in:leader-decision.md"
      ],
      "outputs": [
        "docs/specs/{issue}/ux.md"
      ],
      "checks": [],
      "on_fail": null,
      "summary": "Interaction design before the code."
    },
    {
      "id": "security-review",
      "role": "security",
      "class": "diff-review",
      "inputs": [
        "in:review.diff",
        "docs/specs/{issue}/analysis.md",
        "in:leader-decision.md"
      ],
      "outputs": [],
      "checks": [
        "security-review"
      ],
      "on_fail": {
        "back_to": "@developer",
        "max": 2
      },
      "summary": "Security review of the diff."
    },
    {
      "id": "fix-discovery",
      "role": "developer",
      "class": "fix",
      "inputs": [
        "in:blocking-discoveries.md",
        "docs/specs/{issue}/analysis.md",
        "in:failure-summary.md",
        "in:leader-decision.md"
      ],
      "outputs": [],
      "checks": [],
      "on_fail": {
        "back_to": "@developer",
        "max": 2
      },
      "summary": "Fix a discovery that blocks an AC."
    }
  ]
}
