{
  "format": 1,
  "description": "P3-A: developer changes src/a.py and commits; clean tree at the end.",
  "stream": "../f2/r4.jsonl",
  "init_from_argv": true,
  "structured_output": {
    "status": "done",
    "outputs": [],
    "requests": [],
    "blocked_by": null,
    "discoveries": [],
    "note": "fixture"
  },
  "actions": [
    {
      "op": "write",
      "path": "src/a.py",
      "content": "x = 2\n"
    },
    {
      "op": "git",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "op": "git",
      "args": [
        "commit",
        "-q",
        "-m",
        "work"
      ]
    }
  ]
}
