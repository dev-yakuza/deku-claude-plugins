{
  "format": 1,
  "template": "feature",
  "version": "exp-1",
  "description": "Feature template (design §2.1; the 0.98.7 implement flow, serial). Stage 2 ends it with the leader's done-gate right before the PR (scope D19); a stage-1 engine loads it without that step (instructions.load_default_template). Named commands it needs in the repository settings: setup, lint, typecheck, test, build, e2e, plus the plugin commands ac-coverage and verify-gate. This plugin default lists every verification run; a repository without lint, typecheck, build or e2e drops that step in its own copy (the conversion script does it).",
  "steps": [
    {
      "id": "test-cases",
      "role": "tester",
      "inputs": [
        "docs/specs/{issue}/analysis.md",
        "in:failure-summary.md",
        "in:leader-decision.md"
      ],
      "outputs": [
        "docs/specs/{issue}/test-cases.md"
      ]
    },
    {
      "id": "ac-coverage",
      "run": "ac-coverage",
      "inputs": [
        "docs/specs/{issue}/analysis.md",
        "docs/specs/{issue}/test-cases.md"
      ],
      "on_fail": {
        "back_to": "test-cases",
        "max": 2
      }
    },
    {
      "id": "design",
      "role": "tech-lead",
      "inputs": [
        "docs/specs/{issue}/analysis.md",
        "docs/specs/{issue}/test-cases.md",
        "in:failure-summary.md",
        "in:leader-decision.md"
      ],
      "outputs": [
        "docs/specs/{issue}/skeleton.md"
      ]
    },
    {
      "id": "setup",
      "run": "setup"
    },
    {
      "id": "implement",
      "role": "developer",
      "inputs": [
        "docs/specs/{issue}/analysis.md",
        "docs/specs/{issue}/skeleton.md",
        "docs/specs/{issue}/test-cases.md",
        "in:failure-summary.md",
        "in:leader-decision.md",
        "in:pr-review.md",
        "in:blocking-discoveries.md"
      ],
      "outputs": [],
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "lint",
      "run": "lint",
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "typecheck",
      "run": "typecheck",
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "test",
      "run": "test",
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "build",
      "run": "build",
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "e2e",
      "run": "e2e",
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "review-design",
      "role": "tech-lead",
      "inputs": [
        "in:review.diff",
        "docs/specs/{issue}/skeleton.md",
        "docs/specs/{issue}/analysis.md",
        "in:leader-decision.md"
      ],
      "outputs": [],
      "checks": [
        "design-conformance"
      ],
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "review-tests",
      "role": "tester",
      "inputs": [
        "in:review.diff",
        "docs/specs/{issue}/test-cases.md",
        "docs/specs/{issue}/analysis.md",
        "in:leader-decision.md"
      ],
      "outputs": [],
      "checks": [
        "test-quality"
      ],
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "review-audit",
      "role": "auditor",
      "inputs": [
        "in:review.diff",
        "docs/specs/{issue}/analysis.md",
        "docs/specs/{issue}/skeleton.md",
        "docs/specs/{issue}/test-cases.md",
        "in:leader-decision.md"
      ],
      "outputs": [],
      "checks": [
        "diff-review"
      ],
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "qa",
      "role": "qa",
      "inputs": [
        "in:review.diff",
        "docs/specs/{issue}/analysis.md",
        "docs/specs/{issue}/skeleton.md",
        "docs/specs/{issue}/test-cases.md",
        "in:leader-decision.md"
      ],
      "outputs": [
        "docs/specs/{issue}/manual-test-checklist.md"
      ],
      "checks": [
        "qa-acceptance"
      ],
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "verify-gate",
      "run": "verify-gate",
      "on_fail": {
        "back_to": "implement",
        "max": 2
      }
    },
    {
      "id": "done-gate",
      "check": "done-gate",
      "inputs": [
        "docs/specs/{issue}/analysis.md",
        "docs/specs/{issue}/test-cases.md",
        "docs/specs/{issue}/skeleton.md",
        "docs/specs/{issue}/manual-test-checklist.md",
        "in:review.diff",
        "in:leader-decision.md"
      ]
    },
    {
      "id": "pr",
      "op": "create-pr",
      "inputs": [
        "docs/specs/{issue}/analysis.md",
        "docs/specs/{issue}/manual-test-checklist.md"
      ]
    },
    {
      "id": "followups",
      "op": "create-followups"
    }
  ]
}
